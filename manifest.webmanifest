{
  "name": "GOATout",
  "short_name": "GOATout",
  "description": "Go out. Be the GOAT. Tes sorties t'appartiennent.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f0e0d",
  "theme_color": "#0f0e0d",
  "icons": [
    { "src": "icons/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "fichiers",
          "accept": [".fit", ".zip", ".gpx", ".tcx", ".gz", "application/octet-stream", "application/zip", "application/gzip", "application/gpx+xml", "application/vnd.ant.fit"]
        }
      ]
    }
  }
}
